# ---- Docker Compose stack ----
# Elastic Stack version
STACK_VERSION=9.5.6

# Elasticsearch built-in superuser password.
# Used by docker-compose to bootstrap ES and by `npm run setup:es` to create the
# dedicated application credentials. The running API does NOT need this once an
# ELASTICSEARCH_API_KEY is configured.
ELASTIC_PASSWORD=change-me-elastic-password

# MongoDB root credentials (docker-compose bootstrap)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-mongo-password

# Redis password (docker-compose)
REDIS_PASSWORD=change-me-redis-password

# Kibana service account password (set via `npm run setup:es`)
KIBANA_SYSTEM_PASSWORD=change-me-kibana-password

# Kibana encryption key - MUST be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KIBANA_ENCRYPTION_KEY=change-me-min-32-char-random-hex-string

# ---- Backend API ----
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# MongoDB connection string (source of truth)
MONGODB_URI=mongodb://admin:change-me-mongo-password@127.0.0.1:27018/searchforge?authSource=admin

# Elasticsearch node URL
ELASTICSEARCH_URL=http://127.0.0.1:9200

# Preferred: API key for the dedicated searchforge_app account.
# Create it with: npm run setup:es   (uses ELASTIC_PASSWORD once, prints the key)
# Leave empty to fall back to basic auth below (local development only).
ELASTICSEARCH_API_KEY=

# Fallback basic-auth credentials for local development when no API key is set.
# In non-dev environments use an API key; never the elastic superuser.
ELASTICSEARCH_USERNAME=searchforge_app
ELASTICSEARCH_APP_PASSWORD=

# Redis connection URL
REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379
