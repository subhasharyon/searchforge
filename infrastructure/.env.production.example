# SearchForge production — copy to infrastructure/.env.production and fill in.
# Loaded by: docker compose -f docker-compose.prod.yml --env-file .env.production

# ---- Site ------------------------------------------------------------------
# Public hostname Caddy serves HTTPS for, e.g. searchforge.duckdns.org
DOMAIN=

# ---- Datastore secrets -----------------------------------------------------
ELASTIC_PASSWORD=                    # elastic superuser bootstrap only
MONGO_ROOT_USERNAME=searchforge
MONGO_ROOT_PASSWORD=
MONGO_DB=searchforge
REDIS_PASSWORD=

# ---- Elasticsearch app auth ------------------------------------------------
# Run `docker compose -f docker-compose.prod.yml --env-file .env.production \
#   exec backend npx tsx scripts/setup-es-app-user.ts` once, then set:
# ELASTICSEARCH_API_KEY=
# Until then the backend falls back to the elastic superuser below:
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_APP_PASSWORD=same as ELASTIC_PASSWORD

# ---- Auth ------------------------------------------------------------------
# openssl rand -hex 48 for each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# AUTH_CREDENTIAL_RATE_LIMIT=20

# ---- Frontend service account (internal maintenance calls only) ------------
# SEARCH_API_EMAIL=
# SEARCH_API_PASSWORD=

# ---- Embeddings (Voyage via OpenAI-compatible API) -------------------------
# EMBEDDING_PROVIDER=openai-compat
# EMBEDDING_API_URL=https://api.voyageai.com/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=voyage-3
# EMBEDDING_DIMS=1024

# ---- RAG answers -----------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# ASK_RATE_LIMIT=30
