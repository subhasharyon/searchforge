# SearchForge web tier — copy to infrastructure/.env.web on the web VM.
# Loaded by: docker compose -f docker-compose.web.yml --env-file .env.web

# ---- Site ------------------------------------------------------------------
# Public hostname Caddy serves HTTPS for, e.g. searchforge.duckdns.org
DOMAIN=

# ---- API VM ----------------------------------------------------------------
# Private IP of the API VM (OCI → Instance → Private IP)
API_VM_IP=10.0.0.54

# Same Redis password as .env.api on the API VM — the frontend stores
# sessions in that Redis over the VCN private network.
REDIS_PASSWORD=

# ---- Service account (internal maintenance calls only) --------------------
# SEARCH_API_EMAIL=
# SEARCH_API_PASSWORD=
