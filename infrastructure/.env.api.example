# SearchForge API tier — copy to infrastructure/.env.api on the API VM.
# Loaded by: docker compose -f docker-compose.api.yml --env-file .env.api

# ---- Site ------------------------------------------------------------------
# Public hostname (used only for CORS on the API side)
DOMAIN=

# ---- Datastores ------------------------------------------------------------
# MongoDB Atlas M0 connection string (includes user/password/db):
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/searchforge

# Redis on this VM — frontend also uses this password via .env.web
REDIS_PASSWORD=

# ---- Elasticsearch (managed / Elastic Cloud) -------------------------------
# https endpoint — no trailing slash, e.g.
# https://<id>.es.us-central1.gcp.elastic.cloud
ELASTICSEARCH_URL=
# Scoped API key limited to searchforge-* indices (Kibana → Stack Management
# → API Keys). Falls back to username/password below if unset.
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_APP_PASSWORD=

# ---- Proxy ------------------------------------------------------------------
# Private IP of the web VM — the only trusted X-Forwarded-For hop.
TRUST_PROXY=10.0.0.70

# ---- Auth ------------------------------------------------------------------
# openssl rand -hex 48 for each — MUST match nothing on the web VM;
# these are backend-internal only.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# AUTH_CREDENTIAL_RATE_LIMIT=20

# ---- Embeddings (Voyage via OpenAI-compatible API) -------------------------
# EMBEDDING_PROVIDER=openai-compat
# EMBEDDING_API_URL=https://api.voyageai.com/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=voyage-3
# EMBEDDING_DIMS=1024

# ---- RAG answers -----------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# ASK_RATE_LIMIT=30
