# SearchForge frontend — server-only environment variables.
# None of these may use the NEXT_PUBLIC_ prefix: they are read only by
# Next.js server components/route handlers and must never reach the browser.

# Base URL of the SearchForge backend API (no trailing slash).
SEARCH_API_URL=http://localhost:5000

# Internal service account for server-to-server operations only
# (indexing/maintenance calls — see serviceJson in src/lib/api/client.ts).
# User-facing search/document requests authenticate as the signed-in user
# via the server-side session store; these credentials are NOT used for
# them. Create one via:
#   curl -X POST $SEARCH_API_URL/api/v1/auth/register \
#     -H 'Content-Type: application/json' \
#     -d '{"name":"SearchForge UI","email":"...","password":"..."}'
# Store real credentials in .env.local (gitignored) — never commit them.
SEARCH_API_EMAIL=
SEARCH_API_PASSWORD=

# Optional: Redis-backed session store. When set, sessions survive
# restarts and are shared across instances. When unset, sessions are
# process-local (restart = everyone signs in again).
# REDIS_URL=redis://user:pass@host:6379
