{
  "name": "searchforge-backend",
  "version": "1.0.0",
  "description": "SearchForge API - technical knowledge discovery platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:es": "tsx scripts/setup-es-app-user.ts",
    "seed:eval": "tsx scripts/seed-eval-corpus.ts",
    "seed:corpus": "tsx scripts/seed-corpus.ts",
    "evaluate": "tsx scripts/run-evaluation.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@elastic/elasticsearch": "^9.5.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.5",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.94.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
