{
  "name": "searchforge-backend",
  "version": "1.0.0",
  "description": "SearchForge API - technical knowledge discovery platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "oxlint",
    "test": "vitest run",
